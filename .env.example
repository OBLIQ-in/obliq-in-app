# Login is off by default. Set to "true" to require an Auth0 login.
AUTH_ENABLED=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:4173

# Postgres connection string. Local: `docker compose up -d` uses the value below.
# Hosted (Neon, Supabase): use the pooled connection string.
DATABASE_URL=postgres://obliq:obliq@127.0.0.1:5433/obliq

# Maximum connections per server instance in the database pool (defaults to 1).
DB_POOL_MAX=1

# Development only: act as this seeded user until Auth0 is added (#10).
# Ignored when NODE_ENV is production.
DEV_AUTH_ID=dev|naman

# "local" keeps data in the browser (default). "api" uses the backend.
NEXT_PUBLIC_WORKSPACE_SOURCE=api
# Must match APP_ENV in deployed environments. Staging uses only explicitly
# seeded synthetic data and requires NEXT_PUBLIC_WORKSPACE_SOURCE=api.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
# Required only when running the synthetic seed with APP_ENV=staging.
SEED_SYNTHETIC_DATA=false

# Google Gemini API key for AI PR Review Agent.
# Set as GEMINI_API_KEY in GitHub Repository Secrets (optional locally).
GEMINI_API_KEY=your_gemini_api_key_here